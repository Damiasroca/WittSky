# Copy this file to settings.env and edit it, then run run.ps1 as Administrator.
# Format is KEY=VALUE. No quotes needed. Lines starting with # are ignored.

# --- Access point (Windows hosted network: WPA2-PSK, 2.4 GHz only) ---
# SSID the camera will be told to join. Keep it simple, no spaces.
SSID=hp10lab
# WPA2 passphrase. Must be 8-63 characters.
PSK=change-this-password

# --- Network / addressing ---
# Static IP given to the hosted-network virtual adapter. This is the
# gateway, DNS server, and OTA server the camera talks to.
AP_IP=192.168.50.1
# Subnet prefix length. 24 = 255.255.255.0.
PREFIX=24
# DHCP pool handed to clients. Must be inside the AP_IP subnet and must
# not include AP_IP itself.
DHCP_START=192.168.50.50
DHCP_END=192.168.50.99
# DHCP lease time in seconds.
LEASE_TIME=3600

# --- Spoof target ---
# The hardcoded hostname in the stock firmware's version checker.
# This name is answered with AP_IP; everything else is refused.
OTA_HOST=ota.ecowitt.net
# Host of data.attach1file. The real check returns an https URL on this
# name. The camera rewrites it to http and downloads it on port 80.
# Answered with AP_IP, same as OTA_HOST.
FW_HOST=oss.ecowitt.net

# --- Firmware served to the camera ---
# Path to the image you built, relative to this folder or absolute.
# Copy firmware/build/hp10_bringup.bin here after a successful build.
FW_PATH=firmware/fw.bin
# Version string returned as data.name. Make it higher than V1.1.1 so the
# stock UI shows it as new.
FW_VERSION=V9.9.9
# Changelog text returned as data.content (shown in the stock web UI).
FW_CONTENT=custom firmware
# Poll interval returned as data.queryintval, seconds. Accepted range is
# 300..86368; outside that the device ignores it and uses its default.
QUERY_INTVAL=3600

# --- Ports (defaults match the stock firmware; change only if you know why) ---
HTTP_PORT=80
DNS_PORT=53
DHCP_PORT=67

# --- Auto-trigger ---
# If true, the core watches for the camera's DHCP lease and drives its web
# UI (POST /upgrade_process check -> start). If false, you trigger manually.
AUTO_TRIGGER=false
# Port of the camera's own web UI (served by the camera on this LAN).
CAMERA_WEB_PORT=80
